* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #0a0a0f;
    color: #fff;
    max-width: 420px;
    margin: 0 auto;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
}

/* Header */
.header {
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    padding: 12px 16px;
    border-bottom: 1px solid #2a2a4a;
}

.header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.time {
    color: #888;
    font-size: 14px;
}

.title {
    text-align: center;
    font-weight: bold;
    font-size: 16px;
    color: #e0e0ff;
}

.title small {
    font-size: 10px;
    color: #888;
    font-weight: normal;
}

.close-btn {
    background: none;
    border: none;
    color: #888;
    font-size: 20px;
    cursor: pointer;
}

.header-balance {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
}

.coin {
    color: #ffd700;
    font-weight: bold;
}

.balance {
    font-size: 20px;
    font-weight: bold;
    color: #fff;
}

.luck-badge {
    background: linear-gradient(135deg, #ff6b6b, #ee5a24);
    padding: 2px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: bold;
    color: #fff;
}

/* Navigation */
.main-nav {
    display: flex;
    background: #111122;
    padding: 4px 8px;
    border-bottom: 1px solid #2a2a4a;
    overflow-x: auto;
    gap: 4px;
}

.nav-btn {
    flex: 1;
    padding: 10px 4px;
    background: transparent;
    border: none;
    color: #666;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.3s;
    white-space: nowrap;
}

.nav-btn.active {
    background: #2a2a5a;
    color: #fff;
    box-shadow: 0 0 20px rgba(100, 100, 255, 0.2);
}

/* Tabs */
.tab {
    display: none;
    padding: 12px;
    animation: fadeIn 0.3s;
}

.tab.active {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Trade */
.trade-container {
    background: #12121f;
    border-radius: 16px;
    padding: 16px;
}

.trade-header h2 {
    font-size: 18px;
    color: #e0e0ff;
    margin-bottom: 8px;
}

.ton-price {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #888;
}

.price {
    color: #fff;
    font-weight: bold;
}

.change {
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 12px;
}

.positive { background: #00b894; color: #fff; }
.negative { background: #e17055; color: #fff; }

.trade-balance {
    display: flex;
    gap: 16px;
    margin: 16px 0;
    padding: 12px;
    background: #1a1a2e;
    border-radius: 12px;
}

.balance-item {
    flex: 1;
    text-align: center;
}

.balance-item span:first-child {
    display: block;
    font-size: 12px;
    color: #888;
}

.balance-item .value {
    font-size: 20px;
    font-weight: bold;
    color: #ffd700;
}

.trade-actions {
    display: flex;
    gap: 8px;
    margin: 12px 0;
}

.trade-btn {
    flex: 1;
    padding: 12px;
    border: none;
    border-radius: 10px;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.2s;
}

.trade-btn:active { transform: scale(0.95); }

.buy { background: #00b894; color: #fff; }
.sell { background: #e17055; color: #fff; }
.allin { 
    background: linear-gradient(135deg, #fdcb6e, #f39c12);
    color: #000;
}

.trade-warning {
    font-size: 12px;
    color: #888;
    padding: 12px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
    margin: 8px 0;
}

.market-indicator {
    text-align: right;
    font-size: 14px;
    color: #888;
    margin-top: 8px;
}

/* Slots */
.slots-container, .mines-container {
    background: #12121f;
    border-radius: 16px;
    padding: 16px;
}

.slots-header, .mines-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-size: 18px;
    font-weight: bold;
}

.slots-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 12px 0;
}

.slot-item {
    aspect-ratio: 1;
    background: #1a1a2e;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    transition: all 0.3s;
    border: 2px solid transparent;
}

.slot-item.highlight {
    border-color: #ffd700;
    box-shadow: 0 0 30px rgba(255, 215, 0, 0.3);
}

.slot-controls, .mines-controls {
    display: flex;
    gap: 8px;
    margin: 12px 0;
}

.slot-controls input, .mines-controls input {
    flex: 1;
    padding: 10px;
    background: #1a1a2e;
    border: 1px solid #2a2a4a;
    border-radius: 8px;
    color: #fff;
    font-size: 16px;
}

.spin-btn, .mines-action {
    padding: 10px 20px;
    background: linear-gradient(135deg, #6c5ce7, #a29bfe);
    border: none;
    border-radius: 8px;
    color: #fff;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.2s;
}

.spin-btn:active, .mines-action:active { transform: scale(0.95); }

.slot-result {
    text-align: center;
    padding: 12px;
    background: rgba(255, 215, 0, 0.1);
    border-radius: 8px;
    font-size: 16px;
}

.slot-result span {
    color: #ffd700;
    font-weight: bold;
    font-size: 20px;
}

/* Mines */
.mines-mode {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
}

.mode-btn {
    flex: 1;
    padding: 8px;
    background: #1a1a2e;
    border: 1px solid #2a2a4a;
    border-radius: 8px;
    color: #888;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s;
}

.mode-btn.active {
    background: #6c5ce7;
    color: #fff;
    border-color: #6c5ce7;
}

.mines-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    margin: 12px 0;
}

.mine-cell {
    aspect-ratio: 1;
    background: #1a1a2e;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    cursor: pointer;
    transition: all 0.3s;
    border: 1px solid #2a2a4a;
}

.mine-cell.revealed {
    background: #2a2a5a;
}

.mine-cell.bomb {
    background: #e17055;
    border-color: #e17055;
}

.mine-cell.gem {
    background: #00b894;
    border-color: #00b894;
}

.mine-cell:active { transform: scale(0.9); }

.mines-multipliers {
    display: flex;
    gap: 4px;
    justify-content: center;
    margin: 8px 0;
    font-size: 12px;
    color: #888;
}

.mines-multipliers span {
    padding: 4px 8px;
    background: #1a1a2e;
    border-radius: 6px;
}

.mines-result {
    display: flex;
    justify-content: space-between;
    padding: 12px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
    margin-top: 8px;
}

/* Market */
.market-container {
    background: #12121f;
    border-radius: 16px;
    padding: 16px;
}

.market-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.market-header h3 {
    font-size: 16px;
}

.market-filters {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding-bottom: 8px;
    margin-bottom: 12px;
}

.filter-btn {
    padding: 4px 12px;
    background: #1a1a2e;
    border: 1px solid #2a2a4a;
    border-radius: 20px;
    color: #888;
    font-size: 12px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.3s;
}

.filter-btn.active {
    background: #6c5ce7;
    color: #fff;
    border-color: #6c5ce7;
}

.market-items {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 400px;
    overflow-y: auto;
}

.market-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    background: #1a1a2e;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.3s;
    border: 1px solid transparent;
}

.market-item:hover { border-color: #2a2a4a; }

.market-item .name {
    font-weight: 500;
}

.market-item .price {
    font-weight: bold;
    color: #ffd700;
}

.market-item .rarity {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 12px;
    text-transform: uppercase;
}

.rarity-common { background: #636e72; color: #fff; }
.rarity-rare { background: #0984e3; color: #fff; }
.rarity-epic { background: #6c5ce7; color: #fff; }
.rarity-legendary { background: #fdcb6e; color: #000; }
.rarity-mythic { background: #e17055; color: #fff; }
.rarity-halloween { background: #e17055; color: #fff; }

/* Inventory */
.inventory-container {
    background: #12121f;
    border-radius: 16px;
    padding: 16px;
}

.inventory-container h3 {
    margin-bottom: 8px;
}

.inventory-balance {
    padding: 12px;
    background: #1a1a2e;
    border-radius: 10px;
    text-align: center;
    font-size: 20px;
    font-weight: bold;
    color: #ffd700;
    margin-bottom: 12px;
}

.inventory-items .empty {
    text-align: center;
    color: #666;
    padding: 40px 0;
}

/* Footer */
.footer {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    max-width: 420px;
    width: 100%;
    padding: 10px;
    background: #0a0a0f;
    border-top: 1px solid #1a1a2e;
    text-align: center;
    font-size: 11px;
    color: #666;
    letter-spacing: 0.5px;
}

/* Modal */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.modal.active { display: flex; }

.modal-content {
    background: #1a1a2e;
    padding: 24px;
    border-radius: 16px;
    max-width: 320px;
    width: 90%;
    position: relative;
}

.modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    font-size: 24px;
    cursor: pointer;
    color: #888;
}

.modal-content h3 {
    font-size: 20px;
    margin-bottom: 8px;
}

.modal-content p {
    color: #888;
    margin: 4px 0;
}

.modal-content button {
    width: 100%;
    padding: 12px;
    margin-top: 12px;
    background: linear-gradient(135deg, #6c5ce7, #a29bfe);
    border: none;
    border-radius: 10px;
    color: #fff;
    font-weight: bold;
    font-size: 16px;
    cursor: pointer;
}

/* Scrollbar */
::-webkit-scrollbar {
    width: 3px;
    height: 3px;
}

::-webkit-scrollbar-track {
    background: #0a0a0f;
}

::-webkit-scrollbar-thumb {
    background: #2a2a4a;
    border-radius: 10px;
}
